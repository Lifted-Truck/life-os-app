#!/usr/bin/env bash
# verify — oracle for life-os-app. Layer-0, CI-blocking, stdlib only.
# Usage: ./verify fast | full
set -uo pipefail
cd "$(dirname "$0")"

leak_gate() {
  local hits excludes=(':(exclude).leakcheck-allow' ':(exclude)verify')
  if [ -f .leakcheck-allow ]; then
    local line
    while IFS= read -r line; do
      line="${line%%#*}"; line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
      [ -n "$line" ] && excludes+=(":(exclude)$line")
    done < .leakcheck-allow
  fi
  # Identity: POSIX + Windows home paths (`\\+` catches the JSON-escaped form).
  # `/home/life/` is the deploy box's SERVICE ACCOUNT — a name chosen for the
  # role, not a person — so it is treated as placeholder-class alongside
  # `/Users/<you>/`. It is the ONLY literal account exempted; add another and
  # you are probably about to hide a real leak.
  hits=$(git grep --untracked -nIE '/(Users|home)/[^/]+/|[A-Za-z]:\\+Users\\+[^\\]' -- . "${excludes[@]}" 2>/dev/null \
         | grep -vE '/(Users|home)/[<$@{%]|[A-Za-z]:\\+Users\\+[<$@{%]|/home/life/' || true)
  [ -z "$hits" ] && return 0
  echo "verify: LEAK — machine identity in the tree (use ~/ or a <placeholder>):" >&2
  echo "$hits" | sed 's/^/    /' >&2
  return 1
}

# The path gate cannot see the thing that mattered most here: a bare public
# IPv4 next to `root@` login instructions sat in this PUBLIC repo for ten
# weeks, invisible to every identity scanner. Loopback, 0.0.0.0, and
# obviously-version-shaped dotted quads are exempt; anything else is a
# finding to justify, not a pattern to loosen.
ip_gate() {
  local hits
  # POSIX ERE — git grep does NOT support \b (or \s, or \d). The first draft
  # of this gate used \b and matched NOTHING, which would have shipped a
  # permanently-green IP gate; caught only by planting the real leaked IP and
  # watching it not fire. Word boundaries are done with explicit classes.
  hits=$(git grep --untracked -nIE '(^|[^0-9.])([0-9]{1,3}\.){3}[0-9]{1,3}([^0-9.]|$)' -- . ':(exclude)verify' 2>/dev/null \
         | grep -vE '127\.0\.0\.1|0\.0\.0\.0|255\.255|<VPS_IP>' \
         | grep -vE '(^|[^0-9.])[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{3,}([^0-9.]|$)' || true)
  [ -z "$hits" ] && return 0
  echo "verify: IP — literal IPv4 in the tree of a public repo (use <VPS_IP>):" >&2
  echo "$hits" | sed 's/^/    /' >&2
  return 1
}

fast() {
  local ok=0
  leak_gate || ok=1
  ip_gate   || ok=1
  # Tests run under the repo's OWN interpreter (venv/), never the system one —
  # the system python3 lacks pytest and the first draft of this gate went red
  # on a clean tree for that reason alone. A missing venv is reported as
  # SKIP, audibly: a gate that passes in silence is indistinguishable from
  # one that never ran, and a gate that fails for an unrelated reason gets
  # switched off.
  if [ -x venv/bin/python ] && [ -d tests ]; then
    venv/bin/python -m pytest -q tests || { echo "verify: tests red" >&2; ok=1; }
  else
    echo "verify: SKIP tests (no venv/bin/python — run: python3 -m venv venv && venv/bin/pip install -e .[dev])" >&2
  fi
  return $ok
}

case "${1:-fast}" in
  fast) fast ;;
  full) fast ;;
  *) echo "usage: ./verify fast|full" >&2; exit 2 ;;
esac
