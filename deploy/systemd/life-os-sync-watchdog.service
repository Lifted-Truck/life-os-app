[Unit]
Description=Life-OS data-tree sync staleness watchdog
After=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=life
Group=life
WorkingDirectory=/home/life/data
ExecStart=/bin/bash /home/life/app/deploy/bin/sync-watchdog.sh

NoNewPrivileges=true
PrivateTmp=true
